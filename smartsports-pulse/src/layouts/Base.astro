---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

type Props = {
  title: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  published?: Date;
};

const {
  title,
  description = SITE.description,
  canonical,
  type = 'website',
  published,
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).toString().replace(/\/$/, '');
const ogImage = new URL('/og.svg', SITE.domain).toString();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': type === 'article' ? 'Article' : 'WebSite',
      name: pageTitle,
      headline: title,
      description,
      url: canonicalUrl,
      inLanguage: 'ko-KR',
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.domain,
      },
      ...(published ? { datePublished: published.toISOString() } : {}),
    })} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
