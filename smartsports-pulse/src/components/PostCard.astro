---
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<a class="card" href={`/blog/${post.id}`}>
  <span class="chip">{post.data.category}</span>
  <h3>{post.data.title}</h3>
  <p class="muted" style="margin:0">{post.data.description}</p>
  <p class="meta">{date}</p>
</a>
