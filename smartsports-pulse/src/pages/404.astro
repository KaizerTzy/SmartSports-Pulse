---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다.">
  <div class="wrap page-hero" style="padding-bottom:4rem">
    <h1>이 주소에는 경기가 없습니다</h1>
    <p class="muted">가이드나 아티클 목록에서 다시 찾아 보세요.</p>
    <p>
      <a class="btn btn-ink" href="/">홈으로</a>
      <a class="btn" href="/blog" style="margin-left:0.5rem">아티클</a>
    </p>
  </div>
</Base>
