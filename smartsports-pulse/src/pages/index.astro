---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import AffiliateBanner from '../components/AffiliateBanner.astro';
import { SITE } from '../site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 6);
const date = featured.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} canonical="/">
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <p class="kicker">Sports analysis desk</p>
        <h1>{SITE.tagline}</h1>
        <p class="lede">
          초보 팬도 따라올 수 있는 경기 분석 가이드, 배당을 확률로 바꾸는 해설, 그리고 AI가 초안을 잡고 사람이 검증하는
          데일리 프리뷰. 스마트스포츠 펄스는 흥분보다 근거를 남깁니다.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/guides">입문 가이드 시작</a>
          <a class="btn btn-ghost" href="/previews">오늘의 프리뷰 방법</a>
        </div>
      </div>
      <svg class="pulse-svg" viewBox="0 0 560 180" fill="none" aria-hidden="true">
        <path d="M0 110h70l20-54 28 120 32-150 26 96 18-36h80l16-44 22 92 18-48 30 20H560" stroke="#9EE8DC" stroke-width="3" />
        <circle cx="118" cy="56" r="6" fill="#D85A1A" />
      </svg>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>이번 주 대표 글</h2>
        <a href="/blog">전체 아티클</a>
      </div>
      <a class="featured" href={`/blog/${featured.id}`}>
        <div class="featured-copy">
          <span class="chip">{featured.data.category}</span>
          <h2 style="margin:0.5rem 0 0.6rem">{featured.data.title}</h2>
          <p class="muted">{featured.data.description}</p>
          <p class="meta">{date}</p>
        </div>
        <div class="featured-visual">
          <span class="kicker">대표 글</span>
          <strong style="font-size:1.4rem;letter-spacing:-0.04em">근거 → 가설 → 복기</strong>
        </div>
      </a>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>90일을 위한 학습 경로</h2>
        <a href="/guides">가이드 허브</a>
      </div>
      <div class="path-list">
        <a class="path-item" href="/guides/sports-analysis-basics"><b>01</b>경기 전에 볼 것</a>
        <a class="path-item" href="/guides/odds-explained"><b>02</b>배당을 확률로</a>
        <a class="path-item" href="/guides/football-data"><b>03</b>종목별 데이터</a>
        <a class="path-item" href="/guides/ai-preview-playbook"><b>04</b>AI 프리뷰 검증</a>
        <a class="path-item" href="/guides/glossary"><b>05</b>용어를 고정</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>최신 분석 노트</h2>
        <a href="/blog">더 보기</a>
      </div>
      <div class="grid grid-3">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
      <div style="margin-top:1.4rem">
        <AffiliateBanner slotName="home" />
      </div>
    </div>
  </section>
</Base>
