---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="가이드"
  description="스포츠 분석 입문부터 배당 해설, 종목별 데이터, AI 프리뷰 검증까지. 초보가 90일 안에 루틴을 만드는 학습 경로."
>
  <div class="wrap page-hero">
    <p class="kicker" style="color:var(--pulse-deep)">Playbook</p>
    <h1>가이드</h1>
    <p class="muted">한 번에 다 외우지 마세요. 순서대로 읽고, 한 경기만 직접 적용해 보면 충분합니다.</p>
  </div>
  <div class="wrap" style="padding-bottom:3.2rem">
    <div class="grid grid-2">
      {
        guides.map((guide) => (
          <a class="card" href={`/guides/${guide.id}`}>
            <span class="chip">{guide.data.kicker}</span>
            <h3>{guide.data.title}</h3>
            <p class="muted" style="margin:0">{guide.data.description}</p>
            <p class="meta">약 {guide.data.minutes}분 · {String(guide.data.order).padStart(2, '0')}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
