---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';
import AffiliateBanner from '../components/AffiliateBanner.astro';
import PostCard from '../components/PostCard.astro';

const previews = (await getCollection('blog'))
  .filter((post) => post.data.category === '경기 프리뷰')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<Base
  title="AI 경기 프리뷰"
  description="AI가 초안을 잡고 사람이 검증하는 스마트스포츠 펄스의 경기 프리뷰. 승패를 단정하지 않고 관찰 포인트를 남깁니다."
>
  <div class="wrap page-hero">
    <p class="kicker" style="color:var(--pulse-deep)">Daily desk</p>
    <h1>AI 경기 프리뷰</h1>
    <p class="muted">
      모델은 초안만 씁니다. 결장, 일정, 템포, 세트피스를 사람이 한 번 더 확인한 뒤에야 발행합니다. 아래 카드는 추천 슬립이
      아니라, 검증 순서를 보여 주는 워크드 예시와 종목별 노트입니다.
    </p>
  </div>
  <div class="wrap" style="padding-bottom:3rem">
    <DisclaimerNote />
    <div class="preview-board" style="margin-top:1.2rem">
      <article class="preview-card">
        <span class="chip chip-signal">데스크 규칙</span>
        <h2>초안 → 검증 → 관찰 세 개</h2>
        <p>
          홈 우세 문장이 나와도 결론을 뒤집기보다 <strong>후반 템포</strong>와 <strong>세트피스 빈도</strong>를 고정합니다.
          사실·결장·일정이 비면 발행하지 않습니다.
        </p>
        <div class="stat-row">
          <div class="stat"><span class="muted">모델</span><b>초고만</b></div>
          <div class="stat"><span class="muted">사람</span><b>사실 확인</b></div>
          <div class="stat"><span class="muted">발행</span><b>관찰 3개</b></div>
        </div>
        <p class="muted" style="margin:0">
          방법은 <a href="/guides/ai-preview-playbook">AI 프리뷰 활용법</a>과
          <a href="/blog/ai-preview-five-steps">검증 다섯 단계</a>에 정리했습니다.
        </p>
      </article>
    </div>
    <div class="section-head" style="margin-top:2.2rem">
      <h2>프리뷰 노트</h2>
      <span class="muted">{previews.length}편</span>
    </div>
    <div class="grid grid-3">
      {previews.map((post) => <PostCard post={post} />)}
    </div>
    <p style="margin-top:1.4rem">
      <a class="btn btn-ink" href="/guides/ai-preview-playbook">검증 5단계 가이드</a>
    </p>
    <div style="margin-top:1.4rem">
      <AffiliateBanner slotName="home" />
    </div>
  </div>
</Base>
